# Server Configuration
PORT=5000

# Recipient Email (Where form submissions should be delivered)
RECIPIENT_EMAIL=hkottapa@student.gitam.edu

# SMTP Email Credentials (e.g. Gmail / Outlook / Custom SMTP)
# For Gmail: Use your full Gmail address and an "App Password" (generate at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
